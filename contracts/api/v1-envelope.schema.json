{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkforge.local/contracts/api/v1-envelope.schema.json",
  "title": "API v1 Standard Envelopes",
  "type": "object",
  "$defs": {
    "ErrorEnvelope": {
      "type": "object",
      "required": ["code", "message", "retryable", "correlation_id"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_UNAUTHENTICATED",
            "WORKSPACE_FORBIDDEN",
            "RESOURCE_NOT_FOUND",
            "VALIDATION_ERROR",
            "IDEMPOTENCY_CONFLICT",
            "VERSION_CONFLICT",
            "SUPABASE_UNAVAILABLE",
            "OAUTH_REQUIRED_OR_REVOKED",
            "YOUTUBE_QUOTA_EXCEEDED",
            "AI_PROVIDER_UNAVAILABLE",
            "AI_EXTERNAL_CONSENT_REQUIRED",
            "AI_BUDGET_EXCEEDED",
            "ORIGINALITY_SIMILARITY_BLOCKED",
            "STORAGE_CHECKSUM_MISMATCH",
            "FENCING_TOKEN_STALE",
            "DARKFORGE_UNAVAILABLE"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "properties": {
            "next_action": { "type": "string" },
            "field": { "type": "string" },
            "unavailable_reason": { "type": "string" }
          }
        },
        "correlation_id": { "type": "string", "format": "uuid" },
        "job_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "AcceptedJobResponse": {
      "type": "object",
      "required": ["job_id", "status", "idempotency_key", "correlation_id"],
      "additionalProperties": false,
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["QUEUED", "RUNNING", "PAUSED", "CANCEL_REQUESTED", "BLOCKED", "RECOVERABLE"]
        },
        "idempotency_key": { "type": "string", "minLength": 8 },
        "correlation_id": { "type": "string", "format": "uuid" },
        "deduplicated": { "type": "boolean" }
      }
    }
  }
}
