{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkforge.local/contracts/events/domain-events.schema.json",
  "title": "Outbox Domain Event Contract",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "workspace_id",
    "aggregate_type",
    "aggregate_id",
    "correlation_id",
    "occurred_at",
    "sequence_no",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": {
      "type": "string",
      "enum": [
        "channel.connected",
        "channel.sync.completed",
        "channel.sync.partially_failed",
        "research.completed",
        "opportunity.approved",
        "knowledge.source.indexed",
        "generation.completed",
        "brief.approved",
        "production.requested",
        "job.interrupted",
        "job.failed",
        "job.progress_updated",
        "job.state_changed"
      ]
    },
    "event_version": { "type": "string", "pattern": "^v[0-9]+$" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "type": "string", "minLength": 1 },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "sequence_no": { "type": "integer", "minimum": 1 },
    "payload": {
      "type": "object",
      "description": "Payload minimo sem tokens, cookies, chaves ou copies completas."
    }
  }
}
