# ==============================================================================
# DarkForge Channel OS — Configuração de Ambiente (NUNCA COMMITAR SEGREDOS)
# Copie para .env.local (web) e .env (api/workers) e preencha no ambiente seguro.
# ==============================================================================

# --- Supabase (obrigatório em SP-01+) ---
# URL pública do projeto Supabase de teste
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (publishable / anon) - segura para navegador quando RLS está ativa
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Segredo JWT legado (somente servidor, se usado para verificação local de JWT)
SUPABASE_JWT_SECRET=
# Chave privilegiada (SOMENTE BACKEND/WORKERS - NUNCA expor no Next.js/browser)
SUPABASE_SERVICE_ROLE_KEY=
# String de conexão direta Postgres (migrations, RPCs, workers SKIP LOCKED)
DATABASE_URL=postgresql://postgres:SENHA@db.seu-projeto.supabase.co:5432/postgres?sslmode=require

# --- API Local & Segurança ---
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:3000
# Chave simétrica local (32+ bytes base64) para criptografia de tokens OAuth em repouso
TOKEN_ENCRYPTION_KEY=

# --- YouTube OAuth (obrigatório em SP-03+) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connections/youtube/callback

# --- AI Provider Router (SP-05/SP-06/SP-07) ---
# Padrão seguro: 'local' ou 'none'; provedor externo nunca recebe dados sem consentimento explícito
AI_DEFAULT_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Diretório descartável local ---
DARKFORGE_LOCAL_TEMP_DIR=%LOCALAPPDATA%\DarkForge
# Caminho do núcleo executor DarkForge quando integrado (SP-08)
DARKFORGE_CORE_PATH=
